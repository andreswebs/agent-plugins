root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.go]
indent_style = tab
indent_size = 4

[*.rs]
indent_size = 4
max_line_length = 100

[*.{c,h,cpp,hpp,cxx,hxx,cc,hh}]
indent_size = 4

[*.py]
indent_size = 4

[*.{sh,bash}]
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4
