#!/usr/bin/env bash
# Stand-in for `az account get-access-token`: prints a token unless the
# subscription has a "<id>.notoken" marker in FAKE_CM_DIR.

set -o errexit
set -o nounset
set -o pipefail

function main() {
    local sub=""
    while [ "${#}" -gt 0 ]; do
        case "${1}" in
        --subscription)
            sub="${2}"
            shift 2
            ;;
        *) shift ;;
        esac
    done
    if [ -e "${FAKE_CM_DIR}/${sub}.notoken" ]; then
        echo "ERROR: no account for ${sub}" >&2
        return 1
    fi
    echo "fake-token-${sub}"
}

if [[ "${BASH_SOURCE[0]:-${0}}" == "${0}" ]]; then
    main "${@}"
fi
